let correct = new Set();

function levelText(q){
  if(q.type === 'theory') return 'Lý thuyết';
  if(q.type === 'easy') return 'Bài tập dễ';
  if(q.type === 'medium') return 'Bài tập trung bình';
  return 'Bài tập khó';
}

function renderQuiz(){
  const quiz = document.getElementById('quiz');
  quiz.innerHTML = questions.map(q => `
    <article class="question ${q.type}" data-type="${q.type}" id="q${q.id}">
      <div class="meta">
        <span class="tag ${q.type}">Câu ${q.id}</span>
        <span class="tag ${q.type}">${levelText(q)}</span>
      </div>
      <div class="q-title">${q.question}</div>
      <div class="options">
        ${q.options.map((op, i) => `<button class="option" onclick="chooseAnswer(${q.id}, ${i}, this)">${String.fromCharCode(65+i)}. ${op}</button>`).join('')}
      </div>
      <div class="feedback" id="fb${q.id}">
        <h4></h4>
        <p class="explain"></p>
        <div class="tip"></div>
      </div>
    </article>
  `).join('');
  if(window.MathJax) MathJax.typesetPromise();
}

function chooseAnswer(qid, choice, btn){
  const q = questions.find(item => item.id === qid);
  const card = document.getElementById(`q${qid}`);
  const buttons = [...card.querySelectorAll('.option')];
  if(answered.has(qid)) return;

  answered.add(qid);
  buttons.forEach((b, i) => {
    b.disabled = true;
    if(i === q.answer) b.classList.add('correct');
  });

  const fb = document.getElementById(`fb${qid}`);
  const title = fb.querySelector('h4');
  const exp = fb.querySelector('.explain');
  const tip = fb.querySelector('.tip');

  if(choice === q.answer){
    correct.add(qid);
    btn.classList.add('correct');
    title.innerHTML = '✅ Chính xác!';
  } else {
    btn.classList.add('wrong');
    title.innerHTML = `❌ Chưa đúng. Đáp án đúng là ${String.fromCharCode(65+q.answer)}.`;
  }
  exp.innerHTML = `<b>Giải thích:</b> ${q.explain}`;
  tip.innerHTML = `<b>💡 Mẹo làm nhanh:</b> ${q.tip}`;
  fb.classList.add('show');
  updateStats();
  if(window.MathJax) MathJax.typesetPromise([card]);
}

function updateStats(){
  document.getElementById('doneQ').textContent = answered.size;
  document.getElementById('correctQ').textContent = correct.size;
  document.getElementById('scoreQ').textContent = (correct.size * 10 / questions.length).toFixed(1);
}

function resetQuiz(){
  answered.clear();
  correct.clear();
  renderQuiz();
  updateStats();
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('[data-filter="all"]').classList.add('active');
}

document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;
    document.querySelectorAll('.question').forEach(card => {
      card.classList.toggle('hidden', filter !== 'all' && card.dataset.type !== filter);
    });
  });
});

renderQuiz();
updateStats();
</script>
</body>
</html>
